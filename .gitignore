# ──────────────────────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
*.egg-info/
dist/
build/

# Linter / type-checker / test caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.import_linter_cache/

# Coverage artifacts (`just cov` writes all three)
.coverage
coverage.xml
htmlcov/

# ──────────────────────────────────────────────────────────────
# Node / Next.js (frontend/)
# ──────────────────────────────────────────────────────────────
node_modules/
frontend/.next/
frontend/test-results/
frontend/playwright-report/

# ──────────────────────────────────────────────────────────────
# ATLAS runtime state
# ──────────────────────────────────────────────────────────────
.atlas/
STOP.flag

# E2E ephemeral backend data dir (Playwright webServer wipes/recreates it)
.e2e-data/
*.db
*.db-wal
*.db-shm

# uv lockfile (uv.lock IS committed; the venv is not)
# (do not ignore uv.lock)

# ──────────────────────────────────────────────────────────────
# Secrets & environment
# ──────────────────────────────────────────────────────────────
.env
.env.real
.env.local
.env.production.local

# ──────────────────────────────────────────────────────────────
# OS & editor metadata
# ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
*.iml

# ──────────────────────────────────────────────────────────────
# Other tool leftovers
# ──────────────────────────────────────────────────────────────
.claude/
