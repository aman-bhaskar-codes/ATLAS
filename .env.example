# ─────────────────────────────────────────────────────────────────────────────
# ATLAS environment — the single source of configuration secrets.
#
# THIS IS THE ONLY .env THE PROJECT USES. Its home is next to pyproject.toml at
# the git repository root (ATLAS/atlas/.env). Settings resolves `env_file=".env"`
# relative to the *current working directory*, so run every `atlas` / `uv run`
# command from this directory. A .env anywhere else is dead config.
#
# Copy this file to .env and fill in the blanks. NEVER commit .env.
# Precedence: code defaults < config/settings.yaml < this file / real env vars.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
ATLAS_ENV=dev
ATLAS_DATA_DIR=./.atlas

# ── Model fleet: five OpenRouter free chat models (no Ollama, no other vendor)
ATLAS_DEFAULT_MODEL=glm-5.2-free
ATLAS_HEAVY_MODEL=nemotron-3-ultra-free
ATLAS_PROFILE=free_hybrid
ATLAS_COST_POLICY=free_only
ATLAS_NETWORK_POLICY=free_cloud

# ── REQUIRED — the one key for chat, embeddings AND speech ───────────────────
# OpenRouter serves /chat/completions, /embeddings, /audio/speech and
# /audio/transcriptions on one base URL with this single key.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Embeddings (same key + base URL as chat) ─────────────────────────────────
# qwen3-embedding-0.6b is 1024-dim (as bge-m3 was), so existing Chroma
# collections stay dimension-compatible. Leave ATLAS_EMBED_API_KEY EMPTY to
# reuse OPENROUTER_API_KEY; set it only to point at another vendor
# (Jina/Cohere/Voyage), in which case also change base_url + model. No code
# change is needed either way.
ATLAS_EMBED_PROVIDER=openrouter
ATLAS_EMBED_BASE_URL=https://openrouter.ai/api/v1
ATLAS_EMBED_MODEL=qwen/qwen3-embedding-0.6b
ATLAS_EMBED_API_KEY=

# ── Secret store master key (encrypts every credential ATLAS stores) ────────
# PREFERRED on macOS — Keychain, never on disk:
#   security add-generic-password -a "$USER" -s atlas-master \
#     -w "$(python3 -c 'import secrets;print(secrets.token_hex(32))')"
# Only set this variable on Linux/CI where there is no Keychain. If BOTH are
# unset in dev, ATLAS derives a throwaway key from the hostname and warns —
# anything encrypted under it is lost when you set a real key.
ATLAS_MASTER_KEY=

# ── HTTP API auth — only needed if you expose the API beyond localhost ──────
# Comma-separated bearer keys; a "ro:" prefix makes that key read-only, e.g.
#   ATLAS_API_KEYS=full-key-here,ro:read-only-key-here
# UNSET = local mode: the API binds localhost and every request is treated as
# the trusted local owner. Set it before binding to any other interface.
ATLAS_API_KEYS=
# Token-bucket limits for the API (unset = built-in defaults).
ATLAS_RATE_LIMIT_CAPACITY=
ATLAS_RATE_LIMIT_PER_MINUTE=

# ── Notifications (optional) ────────────────────────────────────────────────
# ntfy.sh topic for approval prompts and task alerts. Empty = no push.
ATLAS_NTFY_TOPIC=
ATLAS_NTFY_CALLBACK_BASE=http://localhost:8730

# ── Voice — OPTIONAL extra vendors (voice.enabled=false by default) ─────────
# NOT required: speech already runs on OPENROUTER_API_KEY above. Fill these
# only to add Deepgram (the one provider with true streaming partials) or Fish
# Audio direct as extra fallbacks.
# PRIVACY: when voice is used, microphone audio and synthesis text are sent to
# a third-party API — audio leaves this machine.
DEEPGRAM_API_KEY=
FISH_AUDIO_API_KEY=

# ── URL-safety scanners (optional) ──────────────────────────────────────────
# Used by the safety layer to screen URLs before a fetch. Empty = that scanner
# is skipped; the rest of the safety funnel still applies.
ATLAS_SAFE_BROWSING_API_KEY=
ATLAS_VIRUSTOTAL_API_KEY=

# ── Extra chat vendors (optional, OUTSIDE the five-free-model fleet) ────────
# Leave empty to stay on OpenRouter free models only. Setting one registers
# that provider at startup; it still cannot be selected unless the active
# cost/network policy allows its cost class.
ATLAS_ANTHROPIC_API_KEY=
ATLAS_GEMINI_API_KEY=
ATLAS_GROQ_API_KEY=

# ── Reserved: future Postgres session backend (Neon/Supabase) ───────────────
# NOT used yet. IDE/ADE session persistence runs on the bundled SQLite DB today
# (.atlas/atlas.db) behind the IDESessionStore protocol. These reserve the env
# names so a future managed-Postgres backend needs no rename. Leave empty.
# SUPABASE_SERVICE_ROLE_KEY is a SECRET — treat like any other credential.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

