# Copy to .env — NEVER commit .env.
ATLAS_ENV=dev
ATLAS_DATA_DIR=./.atlas

# ── Model fleet: five OpenRouter free chat models (no Ollama) ──
# ATLAS_OLLAMA_HOST is retained for optional local use but is no longer read
# for the model fleet.
ATLAS_OLLAMA_HOST=http://localhost:11434
ATLAS_DEFAULT_MODEL=glm-5.2-free
ATLAS_HEAVY_MODEL=nemotron-3-ultra-free
ATLAS_PROFILE=free_hybrid
ATLAS_COST_POLICY=free_only
ATLAS_NETWORK_POLICY=free_cloud
# ── ONE key for everything: chat, embeddings, and speech ──
# OpenRouter serves /chat/completions, /embeddings, /audio/speech and
# /audio/transcriptions on the same base URL with this one key.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Embeddings (same key + base URL as chat) ──
# qwen3-embedding-0.6b is 1024-dim (as bge-m3 was), so existing Chroma
# collections stay dimension-compatible. Leave ATLAS_EMBED_API_KEY empty to
# reuse OPENROUTER_API_KEY; set it only when pointing at another vendor
# (Jina/Cohere/Voyage) — base_url + model are the only other changes needed.
ATLAS_EMBED_PROVIDER=openrouter
ATLAS_EMBED_BASE_URL=https://openrouter.ai/api/v1
ATLAS_EMBED_MODEL=qwen/qwen3-embedding-0.6b
ATLAS_EMBED_API_KEY=

# ── Voice pipeline — OPTIONAL keys (voice.enabled=false by default) ──
# Not required: speech uses OPENROUTER_API_KEY above. Fill these only to add
# Deepgram (the one provider with true streaming partials) or Fish Audio direct
# as extra fallbacks.
# PRIVACY: when voice is used, microphone audio and synthesis text are sent to
# a third-party API — audio leaves the machine.
DEEPGRAM_API_KEY=
FISH_AUDIO_API_KEY=

ATLAS_NTFY_TOPIC=
ATLAS_NTFY_CALLBACK_BASE=http://localhost:8730

# Master key for the encrypted secret store.
# macOS: stored in Keychain (item "atlas-master"). Other OSes / CI: set here (dev only).
ATLAS_MASTER_KEY=
