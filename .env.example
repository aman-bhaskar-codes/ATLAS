# ─────────────────────────────────────────────────────────────────────────────
# ATLAS environment — the single source of configuration secrets.
#
# THIS IS THE ONLY .env THE PROJECT USES. Its home is next to pyproject.toml at
# the git repository root (ATLAS/atlas/.env). Settings resolves `env_file=".env"`
# relative to the *current working directory*, so run every `atlas` / `uv run`
# command from this directory. A .env anywhere else is dead config.
#
# Copy this file to .env and fill in the blanks. NEVER commit .env.
# Precedence: code defaults < config/settings.yaml < this file / real env vars.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
ATLAS_ENV=dev
ATLAS_DATA_DIR=./.atlas
ATLAS_STRICT_BOOTSTRAP=false
ATLAS_HOST=127.0.0.1
ATLAS_PORT=8730
ATLAS_API_KEY=atlas-dev-local-key-2026

# ── Primary Zero-Cost Models & Endpoints ────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434
ATLAS_OLLAMA_HOST=http://127.0.0.1:11434
GEMINI_API_KEY=your_free_google_ai_studio_key
ATLAS_GEMINI_API_KEY=your_free_google_ai_studio_key
ATLAS_PRIMARY_CLOUD_MODEL=gemini/gemini-2.5-flash
ATLAS_PRIMARY_LOCAL_MODEL=ollama/qwen2.5-coder:7b
ATLAS_EMBEDDING_MODEL=ollama/nomic-embed-text

# ── Frontend Next.js 16 Client Configuration ────────────────────────────────
NEXT_PUBLIC_ATLAS_API_URL=http://localhost:8730/api/v1
NEXT_PUBLIC_ATLAS_WS_URL=ws://localhost:8730/api/v1/events/ws
NEXT_PUBLIC_ATLAS_API_KEY=atlas-dev-local-key-2026

# ── Chat: local Ollama floor, Gemini, and optional OpenRouter routes ────────
ATLAS_LOCAL_MODEL=qwen3:4b
ATLAS_LOCAL_CONTEXT_LENGTH=8192
ATLAS_DEFAULT_MODEL=local-qwen3
ATLAS_HEAVY_MODEL=gemini-flash
ATLAS_GEMINI_MODEL=gemini-3.8-flash
ATLAS_GEMINI_BILLING_TIER=paid
ATLAS_PROFILE=free_hybrid
ATLAS_COST_POLICY=free_only
ATLAS_NETWORK_POLICY=free_cloud

# ── OPTIONAL — additional OpenRouter chat and speech routes ────────────────
# OpenRouter serves /chat/completions, /embeddings, /audio/speech and
# /audio/transcriptions on one base URL with this single key.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ── Local embeddings — existing bge-m3:latest, no API key ───────────────────
# BGE-M3 is 1024-dimensional. Changing embedding models needs reindexing even
# when dimensions match. For explicit cloud use, set provider=openrouter and
# model=qwen/qwen3-embedding-0.6b; key falls back to OPENROUTER_API_KEY.
ATLAS_EMBED_PROVIDER=ollama
ATLAS_EMBED_BASE_URL=https://openrouter.ai/api/v1
ATLAS_EMBED_MODEL=bge-m3:latest
ATLAS_LOCAL_EMBED_MODEL=bge-m3:latest
ATLAS_EMBED_API_KEY=

# ── Secret store master key (encrypts every credential ATLAS stores) ────────
# PREFERRED on macOS — Keychain, never on disk:
#   security add-generic-password -a "$USER" -s atlas-master \
#     -w "$(python3 -c 'import secrets;print(secrets.token_hex(32))')"
# Only set this variable on Linux/CI where there is no Keychain. If BOTH are
# unset in dev, ATLAS derives a throwaway key from the hostname and warns —
# anything encrypted under it is lost when you set a real key.
ATLAS_MASTER_KEY=

# ── HTTP API auth — only needed if you expose the API beyond localhost ──────
# Comma-separated bearer keys; a "ro:" prefix makes that key read-only, e.g.
#   ATLAS_API_KEYS=full-key-here,ro:read-only-key-here
# UNSET = local mode: the API binds localhost and every request is treated as
# the trusted local owner. Set it before binding to any other interface.
ATLAS_API_KEYS=
# Token-bucket limits for the API (unset = built-in defaults).
ATLAS_RATE_LIMIT_CAPACITY=
ATLAS_RATE_LIMIT_PER_MINUTE=

# ── Notifications (optional) ────────────────────────────────────────────────
# ntfy.sh topic for approval prompts and task alerts. Empty = no push.
ATLAS_NTFY_TOPIC=
ATLAS_NTFY_CALLBACK_BASE=http://localhost:8730

# ── Voice — OPTIONAL extra vendors (voice.enabled=false by default) ─────────
# NOT required: speech already runs on OPENROUTER_API_KEY above. Fill these
# only to add Deepgram (the one provider with true streaming partials) or Fish
# Audio direct as extra fallbacks.
# PRIVACY: when voice is used, microphone audio and synthesis text are sent to
# a third-party API — audio leaves this machine.
DEEPGRAM_API_KEY=
FISH_AUDIO_API_KEY=

# ── URL-safety scanners (optional) ──────────────────────────────────────────
# Used by the safety layer to screen URLs before a fetch. Empty = that scanner
# is skipped; the rest of the safety funnel still applies.
ATLAS_SAFE_BROWSING_API_KEY=
ATLAS_VIRUSTOTAL_API_KEY=

# ── Extra chat vendors (optional) ──────────────────────────────────────────
# Setting one registers
# that provider at startup; it still cannot be selected unless the active
# cost/network policy allows its cost class.
ATLAS_ANTHROPIC_API_KEY=
ATLAS_GROQ_API_KEY=

# ── Domain-routed persistence (Storage Backbone) ────────────────────────────
# ATLAS persistence is a single SEAM routed per domain. Each domain below may
# point at its OWN Supabase (Postgres) account via a DSN. All empty = ATLAS runs
# exactly as today on the bundled SQLite DB (.atlas/atlas.db) — zero regression.
# Fallback chain per domain: <DOMAIN>_DSN -> CORE_DSN -> SQLite. So you can
# enable accounts incrementally: set CORE first to co-locate everything on one
# Postgres, then peel domains off onto their own accounts as you scale.
# Every *_DSN is a SECRET (embeds a password) — treat like any credential.
#
# Six ACTIVE domains (leave empty until you provision that account):
# ATLAS_SUPABASE_CORE_DSN=       # Acct 1 (critical): orchestration, event bus, safety/audit, tooling, routing
# ATLAS_SUPABASE_IDENTITY_DSN=   # Acct 2 (high): secrets, identities (blast-radius isolation)
# ATLAS_SUPABASE_MEMORY_DSN=     # Acct 3: episodes, semantic facts, user_model, trajectories
# ATLAS_SUPABASE_IDE_DSN=        # Acct 4: ide_sessions/workspaces, dev-agent ledger
# ATLAS_SUPABASE_RESEARCH_DSN=   # Acct 5: research sessions, fabric_*, knowledge docs/chunks, rag
# ATLAS_SUPABASE_TELEMETRY_DSN=  # Acct 6: llm_calls, eval_*, adaptation_*, canary_*
#
# Two RESERVED domains — leave unset (dormant until explicitly enabled):
# ATLAS_SUPABASE_ANALYTICS_DSN=      # Acct 7: future replica/warehouse or telemetry overflow
# ATLAS_SUPABASE_ENVIRONMENT_DSN=    # Acct 8: future prod/dev split or dedicated MCP tool-registry DB
#
# Legacy compatibility (existing setups keep working):
#   SUPABASE_DB_CONNECTION_STRING (below) maps to the IDE domain (wired in T5).
#   ATLAS_DATABASE_URL, if introduced, maps to CORE.
# SUPABASE_SERVICE_ROLE_KEY is a SECRET — treat like any other credential.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_CONNECTION_STRING=
